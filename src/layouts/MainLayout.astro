---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pendaftaran Mahasiswa Baru 2026/2027 | Agung Putra University",
  description = "Pendaftaran mahasiswa baru Agung Putra University (IKMB) Tahun Ajaran 2026/2027. 7 program studi unggulan, beasiswa prestasi, dan kampus futuristik hijau di Semarang.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0e1a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-campus.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/hero-campus.jpg" />

    <title>{title}</title>

    <link rel="icon" type="image/png" href="/images/apu-logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Space+Grotesk:wght@300;400;500&family=Space+Mono&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      @tailwind base;
      @tailwind components;
      @tailwind utilities;

      @layer base {
        html {
          scroll-behavior: auto;
        }

        body {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 300;
          color: #1a1a1a;
          background-color: #0a0e1a;
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
          overflow-x: hidden;
        }

        ::selection {
          background-color: rgba(200, 213, 185, 0.3);
          color: #faf6f1;
        }
      }

      @layer components {
        .text-h1 {
          font-family: "Instrument Serif", Georgia, serif;
          font-weight: 400;
          font-size: clamp(2.5rem, 6vw, 5.5rem);
          line-height: 1.05;
          letter-spacing: -0.02em;
        }

        .text-h2 {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 500;
          font-size: clamp(1.5rem, 3vw, 2.5rem);
          line-height: 1.15;
          letter-spacing: -0.01em;
        }

        .text-h3 {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 500;
          font-size: clamp(1.125rem, 2vw, 1.5rem);
          line-height: 1.25;
        }

        .text-body {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 500;
          font-size: 1.1rem;
          line-height: 1.6;
          color: white;
        }

        .text-body-s {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 400;
          font-size: 0.875rem;
          line-height: 1.5;
          color: white;
        }

        .text-caption {
          font-family: "Space Grotesk", system-ui, sans-serif;
          font-weight: 400;
          font-size: 0.75rem;
          line-height: 1.4;
          letter-spacing: 0.05em;
        }

        .text-mono {
          font-family: "Space Mono", monospace;
          font-weight: 400;
          font-size: 0.75rem;
          line-height: 1.4;
          letter-spacing: 0.1em;
          text-transform: uppercase;
        }

        .content-max {
          max-width: 1200px;
          margin-left: auto;
          margin-right: auto;
          padding-left: clamp(1.5rem, 4vw, 3rem);
          padding-right: clamp(1.5rem, 4vw, 3rem);
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
