---
import { contact } from "../data/contact";
---

<footer class="bg-brand-primary-deeper border-t border-brand-border/12">
  <div class="content-max py-16">
    <!-- Row 1: 4-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="space-y-4">
        <img
          src="/images/ikmb.png"
          alt="Agung Putra University"
          class="h-10 w-auto brightness-110"
        />
        <p class="text-brand-surface font-sans font-medium text-sm">
          Institut Karya Mulia Bangsa
        </p>
        <p class="text-brand-surface-alt/78 text-caption leading-relaxed">
          {contact.address}
        </p>
      </div>

      <!-- Jalur Masuk -->
      <div class="space-y-4">
        <h4
          class="text-brand-accent-soft text-caption uppercase tracking-widest font-medium"
        >
          Jalur Masuk
        </h4>
        <ul class="space-y-2 text-white">
          <li>
            <a
              href="#jalur-masuk"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >Jalur Reguler</a
            >
          </li>
          <li>
            <a
              href="#jalur-masuk"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >Jalur Beasiswa</a
            >
          </li>
          <li>
            <a
              href="#jalur-masuk"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >Gelombang Pendaftaran</a
            >
          </li>
        </ul>
      </div>

      <!-- Program Studi -->
      <div class="space-y-4">
        <h4
          class="text-brand-accent-soft text-caption uppercase tracking-widest font-medium"
        >
          Program Studi
        </h4>
        <ul class="space-y-2 text-white">
          <li>
            <a
              href="#program"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >S1 Biomedical Science</a
            >
          </li>
          <li>
            <a
              href="#program"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >S1 Biotechnology</a
            >
          </li>
          <li>
            <a
              href="#program"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >S1 Hukum</a
            >
          </li>
          <li>
            <a
              href="#program"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >S1 Manajemen</a
            >
          </li>
          <li>
            <a
              href="#program"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
              >S1 Ilmu Komunikasi</a
            >
          </li>
        </ul>
      </div>

      <!-- Kontak -->
      <div class="space-y-4">
        <h4
          class="text-brand-accent-soft text-caption uppercase tracking-widest font-medium"
        >
          Kontak
        </h4>
        <ul class="space-y-2 text-white">
          <li>
            <a
              href={contact.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
            >
              WA: {contact.whatsapp}
            </a>
          </li>
          <li>
            <a
              href={contact.websiteLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
            >
              {contact.website}
            </a>
          </li>
          <li>
            <a
              href={contact.scholarshipLink}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-surface-alt/78 text-body-s hover:text-brand-accent-soft transition-colors duration-300"
            >
              scholarship.kmb.ac.id
            </a>
          </li>
        </ul>
        <div class="pt-2 flex items-center gap-4">
          <a
            href={contact.social.instagramLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-brand-surface-alt/75 hover:text-brand-accent-soft transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
            >
          </a>
          <a
            href={contact.social.tiktokLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="text-brand-surface-alt/75 hover:text-brand-accent-soft transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg
            >
          </a>
          <a
            href={contact.social.twitterLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X"
            class="text-brand-surface-alt/75 hover:text-brand-accent-soft transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path></svg
            >
          </a>
          <a
            href={contact.social.youtubeLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="text-brand-surface-alt/75 hover:text-brand-accent-soft transition-colors duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.13c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
              ></path><polygon
                points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"
              ></polygon></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-brand-border/14 my-10"></div>

    <!-- Copyright -->
    <div class="text-center text-white">
      <p class="text-brand-surface-alt/78 text-caption">
        &copy; 2025 Institut Karya Mulia Bangsa. All rights reserved.
      </p>
    </div>
  </div>
</footer>
