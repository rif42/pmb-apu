---
import ScrollReveal from '../components/ScrollReveal.astro';
import { pathways } from '../data/pathways';

const getBadgeClasses = (type: string) => {
  switch (type) {
    case 'active':
      return 'bg-soft-sage/20 text-deep-sage';
    case 'upcoming':
      return 'bg-warm-ivory border border-soft-sage/40 text-deep-sage';
    default:
      return 'bg-warm-ivory border border-soft-sage/40 text-slate';
  }
};
---

<section id="jalur-masuk" class="bg-warm-ivory py-24 md:py-32">
  <div class="content-max">
    <!-- Section Header -->
    <ScrollReveal class="text-center mb-16">
      <span class="text-mono text-burnt-copper tracking-widest block mb-4">JALUR PENDAFTARAN</span>
      <h2 class="text-h2 text-charcoal mb-4">Dua Jalur Menuju Kampus Impian</h2>
      <p class="text-body text-slate max-w-xl mx-auto">
        Pilih jalur yang sesuai dengan potensi dan persiapanmu. Kami membuka kesempatan seluas-luasnya untuk calon mahasiswa berprestasi.
      </p>
    </ScrollReveal>

    <!-- Two Column Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {pathways.map((pathway, index) => (
        <ScrollReveal delay={index * 150}>
          <div class="bg-brand-surface border border-soft-sage/40 rounded-xl p-8 h-full transition-all duration-300 hover:shadow-lg hover:border-deep-sage/40 group">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-full bg-soft-sage/15 text-deep-sage flex items-center justify-center mb-6">
              {pathway.icon === 'graduation-cap' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.66 2.24 3 5 3s5-1.34 5-3v-5"/></svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-h3 text-charcoal mb-3">{pathway.name}</h3>

            <!-- Description -->
            <p class="text-body-s text-slate mb-6">{pathway.description}</p>

            <!-- Waves or Scholarships -->
            {pathway.waves && (
              <div class="space-y-3 mb-6">
                {pathway.waves.map((wave) => (
                  <div class="flex items-center justify-between p-3 bg-warm-ivory/80 rounded-lg border border-soft-sage/20">
                    <div>
                      <p class="text-body-s font-medium text-charcoal">{wave.name}</p>
                      <p class="text-caption text-slate">{wave.period}</p>
                    </div>
                    <span class={`text-caption font-medium px-3 py-1 rounded-full whitespace-nowrap ${getBadgeClasses(wave.badgeType)}`}>
                      {wave.benefit}
                    </span>
                  </div>
                ))}
              </div>
            )}

            {pathway.scholarships && (
              <div class="space-y-2 mb-6">
                {pathway.scholarships.map((scholarship) => (
                  <div class="flex items-center gap-3 p-3 bg-warm-ivory/80 rounded-lg border border-soft-sage/20">
                    <div class="w-2 h-2 rounded-full bg-deep-sage flex-shrink-0"></div>
                    <span class="text-body-s text-charcoal">{scholarship}</span>
                  </div>
                ))}
              </div>
            )}

            <!-- CTA -->
            <a
              href={pathway.ctaLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex border-2 border-solid border-deep-sage p-2 rounded-xl items-center gap-2 text-deep-sage text-body-s font-medium group-hover:gap-3 hover:bg-soft-sage/15 transition-all duration-300"
            >
              <span>{pathway.ctaText}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </ScrollReveal>
      ))}
    </div>

    <!-- Note -->
    <ScrollReveal class="text-center mt-8">
      <p class="text-caption text-slate">
        *Syarat dan ketentuan berlaku untuk setiap jalur pendaftaran
      </p>
    </ScrollReveal>
  </div>
</section>
