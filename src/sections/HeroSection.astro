---
import { contact } from "../data/contact";
---

<section
    id="beranda"
    class="relative min-h-[100dvh] flex items-end overflow-hidden"
>
    <!-- Background Image Layer -->
    <div id="hero-bg" class="absolute inset-0 z-[1] will-change-transform">
        <img
            src="/images/ikmb-background.webp"
            alt="Kampus Futuristik Universitas Agung Putra"
            class="w-full h-full object-cover"
            loading="eager"
            id="hero-bg-img"
        />
        <!-- Gradient Overlays -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-brand-accent/70 via-deep-sage/50 to-transparent"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-r from-deep-sage/45 via-transparent to-deep-sage/45"
        >
        </div>
        <div class="absolute inset-0 bg-deep-sage/18"></div>
    </div>

    <!-- Animated Particle/Stars Layer -->
    <div
        id="hero-particles"
        class="absolute inset-0 z-[2] overflow-hidden pointer-events-none"
    >
        <!-- Particles will be generated by JS -->
    </div>

    <!-- Content Layer -->
    <div class="relative z-[3] w-full pb-20 md:pb-28">
        <div class="content-max">
            <!-- Tagline -->
            <div id="hero-tagline" class="mb-6 opacity-0">
                <span class="text-mono text-warm-ivory/85 tracking-widest"
                    >APU Semarang</span
                >
            </div>

            <!-- Main Headline -->
            <h1
                id="hero-headline"
                class="text-h1 text-warm-ivory mb-6 max-w-4xl opacity-0"
            >
                <span class="block">Pendaftaran</span>
                <span
                    class="block text-brand-accent-soft tracking-wide font-bold"
                    >Mahasiswa Baru</span
                >
                <span class="block">2026/2027</span>
            </h1>

            <!-- Subtitle -->
            <p
                id="hero-subtitle"
                class="text-body text-warm-ivory/85 max-w-xl mb-10 opacity-0"
            >
                Futuristic Green Campus — Kampus unggulan nan futuristik yang
                berada di jantung ekosistem SCCR yang kuat, canggih, dan ramah
                lingkungan.
            </p>

            <!-- CTA Buttons -->
            <div id="hero-cta" class="flex flex-wrap gap-4 opacity-0">
                <a
                    href={contact.pmbLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-8 py-3.5 bg-brand-primary text-warm-ivory text-body font-medium rounded transition-all duration-300 hover:bg-deep-space hover:scale-[1.02]"
                >
                    <span>Daftar Sekarang</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                        ></path></svg
                    >
                </a>
                <a
                    href="#jalur-masuk"
                    class="inline-flex items-center gap-2 px-8 py-3.5 border border-warm-ivory/45 text-warm-ivory text-body font-medium rounded transition-all duration-300 hover:bg-warm-ivory/10 hover:border-warm-ivory/75"
                >
                    <span>Lihat Jalur Masuk</span>
                </a>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div
            id="scroll-indicator"
            class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0"
        >
            <span class="text-caption text-warm-ivory/75"
                >Gulir untuk menjelajah</span
            >
            <svg
                class="animate-bounce-slow text-warm-ivory"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
            >
        </div>
    </div>
</section>

<script>
    (function () {
        // Generate floating particles
        const particleContainer = document.getElementById("hero-particles");
        if (particleContainer) {
            for (let i = 0; i < 30; i++) {
                const particle = document.createElement("div");
                const size = Math.random() * 3 + 1;
                particle.className = "absolute rounded-full bg-warm-ivory/20";
                particle.style.cssText = `
          width: ${size}px;
          height: ${size}px;
          left: ${Math.random() * 100}%;
          top: ${Math.random() * 100}%;
          animation: float ${Math.random() * 6 + 4}s ease-in-out infinite;
          animation-delay: ${Math.random() * 5}s;
        `;
                particleContainer.appendChild(particle);
            }
        }

        // Float animation keyframes
        const style = document.createElement("style");
        style.textContent = `
      @keyframes float {
        0%, 100% { transform: translateY(0) translateX(0); opacity: 0.2; }
        25% { transform: translateY(-20px) translateX(10px); opacity: 0.5; }
        50% { transform: translateY(-40px) translateX(-5px); opacity: 0.3; }
        75% { transform: translateY(-20px) translateX(15px); opacity: 0.4; }
      }
    `;
        document.head.appendChild(style);

        // Entrance animation
        const headline = document.getElementById("hero-headline");
        const tagline = document.getElementById("hero-tagline");
        const subtitle = document.getElementById("hero-subtitle");
        const cta = document.getElementById("hero-cta");
        const scrollIndicator = document.getElementById("scroll-indicator");
        const bg = document.getElementById("hero-bg");

        // Wait for fonts to load
        document.fonts.ready.then(() => {
            // Background entrance
            if (bg) {
                bg.style.transition =
                    "opacity 2.5s ease-out, transform 3s ease-out";
                bg.style.opacity = "1";
                bg.style.transform = "scale(1)";
            }

            // Staggered content entrance
            setTimeout(() => {
                if (tagline) {
                    tagline.style.transition =
                        "opacity 0.8s ease-out, transform 0.8s ease-out";
                    tagline.style.opacity = "1";
                    tagline.style.transform = "translateY(0)";
                }
            }, 500);

            setTimeout(() => {
                if (headline) {
                    headline.style.transition =
                        "opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1)";
                    headline.style.opacity = "1";
                    headline.style.transform = "translateY(0)";
                }
            }, 800);

            setTimeout(() => {
                if (subtitle) {
                    subtitle.style.transition =
                        "opacity 0.8s ease-out, transform 0.8s ease-out";
                    subtitle.style.opacity = "1";
                    subtitle.style.transform = "translateY(0)";
                }
            }, 1200);

            setTimeout(() => {
                if (cta) {
                    cta.style.transition =
                        "opacity 0.6s ease-out, transform 0.6s ease-out";
                    cta.style.opacity = "1";
                    cta.style.transform = "translateY(0)";
                }
            }, 1600);

            setTimeout(() => {
                if (scrollIndicator) {
                    scrollIndicator.style.transition = "opacity 0.6s ease-out";
                    scrollIndicator.style.opacity = "1";
                }
            }, 2200);
        });

        // Mouse parallax on background
        let mouseX = 0,
            mouseY = 0;
        let currentX = 0,
            currentY = 0;
        const bgImg = document.getElementById("hero-bg-img");

        document.addEventListener("mousemove", (e) => {
            mouseX = (e.clientX / window.innerWidth - 0.5) * 20;
            mouseY = (e.clientY / window.innerHeight - 0.5) * 20;
        });

        function animateParallax() {
            currentX += (mouseX - currentX) * 0.08;
            currentY += (mouseY - currentY) * 0.08;
            if (bgImg) {
                bgImg.style.transform = `translate(${currentX}px, ${currentY}px) scale(1.05)`;
            }
            requestAnimationFrame(animateParallax);
        }
        animateParallax();

        // Scroll-linked collapse
        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        const scrollY = window.scrollY;
                        const heroHeight =
                            document.querySelector("#beranda")?.clientHeight ||
                            window.innerHeight;
                        const progress = Math.min(scrollY / heroHeight, 1);

                        if (headline) {
                            const scale = 1 - progress * 0.08;
                            const yOffset = -progress * 12;
                            const opacity = 1 - progress * 0.85;
                            headline.style.transform = `scale(${scale}) translateY(${yOffset}%)`;
                            headline.style.opacity = String(
                                Math.max(opacity, 0),
                            );
                        }

                        if (tagline) {
                            tagline.style.transform = `translateY(${-progress * 25}%)`;
                            tagline.style.opacity = String(
                                Math.max(1 - progress, 0),
                            );
                        }

                        if (scrollIndicator) {
                            scrollIndicator.style.opacity = String(
                                Math.max(1 - progress * 3, 0),
                            );
                        }

                        ticking = false;
                    });
                    ticking = true;
                }
            },
            { passive: true },
        );
    })();
</script>
